<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BfresMcUpdaterTest</RootNamespace>
    <AssemblyName>BfresMcUpdaterTest</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Submodules live under lib/; SDK would otherwise compile every **/*.cs there into this exe. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);lib/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="lib\BfresLibrary\BfresLibrary\BfresLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="MaterialDiff.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
